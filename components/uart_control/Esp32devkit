static String robotMenit(long d) {
  if (d < 60) return String(d) + " dtk";
  return String(d / 60) + " mnt " + String(d % 60) + " dtk";
}

static String robotWifiAlasan(int r) {
  switch (r) {
    case 1: return "tidak diketahui";
    case 2: return "sesi kedaluwarsa";
    case 3: return "diputus AP (deauth)";
    case 4: return "asosiasi kedaluwarsa";
    case 8: return "diputus AP (disassoc)";
    case 15: return "jabat tangan gagal";
    case 200: return "sinyal hilang (beacon timeout)";
    case 201: return "AP tidak ditemukan";
    case 202: return "gagal autentikasi";
    case 205: return "koneksi gagal";
    default: return String("kode ") + String(r);
  }
}

// Ubah keterangan mentah dari robot menjadi kalimat. Gemini: "<sumber>:<errno>:<kode tutup>:<sesi detik>:<aktivitas>"
static String robotDetailText(const char* kind, const char* detail) {
  if (!detail || !detail[0]) return String("");
  if (!strcmp(kind, "wifi_putus") && detail[0] == 'r') return String("Alasan: ") + robotWifiAlasan(atoi(detail + 1));
  if (strcmp(kind, "gemini_putus")) return String("");
  char tmp[48]; strncpy(tmp, detail, sizeof(tmp) - 1); tmp[sizeof(tmp) - 1] = '\0';
  char* f[5]; int n = robotSplit2(tmp, f, 5);
  if (n < 5) return String("");
  String o;
  if (!strcmp(f[0], "err")) o += "error jaringan"; else if (!strcmp(f[0], "dc")) o += "terputus"; else if (!strcmp(f[0], "cl")) o += "ditutup"; else o += f[0];
  int en = atoi(f[1]);
  if (en < 0) {
    if (en == -1) o += ", jalur jaringan (TCP) putus";
    else if (en == -2) o += ", tidak ada balasan ping (pong timeout)";
    else if (en == -3) o += ", gagal jabat tangan awal";
    else if (en == -4) o += ", server menutup";
    else o += String(", jenis error ") + String(-en);
  } else if (en == 104) o += ", di-reset (jaringan/server)"; else if (en == 110) o += ", timeout"; else if (en == 113) o += ", tidak ada rute"; else if (en != 0) o += String(", errno ") + String(en);
  int cc = atoi(f[2]);
  if (cc == 1008) o += ", ditolak server (1008)"; else if (cc == 1011) o += ", error server/kuota (1011)"; else if (cc == 1006) o += ", putus tak normal (1006)"; else if (cc == 1000) o += ", ditutup normal (1000, biasanya robot istirahat)"; else if (cc != 0) o += String(", kode tutup ") + String(cc);
  o += String("; sesi bertahan ") + robotMenit(atol(f[3])) + "; saat " + f[4];
  return o;
}

