void handleRobot() {
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/html; charset=utf-8", "");
  server.sendContent("<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'><meta http-equiv='refresh' content='30'>"
    "<style>body{margin:0;padding:16px;background:#111318;color:#e7e9ef;font:16px Arial,sans-serif}.wrap{max-width:760px;margin:auto}"
    ".box{background:#20232b;border:1px solid #343844;border-radius:12px;padding:14px;margin:10px 0}"
    ".row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #2c303a}.row:last-child{border:0}"
    ".ok{color:#34d399}.bad{color:#f87171}.mid{color:#fbbf24}.small{font-size:12px;color:#9ca3af}"
    ".back{display:block;color:#fff;background:#343844;padding:12px;border-radius:9px;text-decoration:none;margin:10px 0}"
    "</style></head><body><div class='wrap'><a class='back' href='/'>← Kembali</a><h2>Kesehatan Robot</h2>");

  String h;
  uint32_t age = (millis() - robotLastMs) / 1000UL;
  if (!robotEverReported) {
    h += "<div class='box bad'>Belum ada laporan dari robot. Pastikan robot sudah diperbarui dan menyala (laporan datang tiap 1 menit).</div>";
  } else {
    bool fresh = age <= 150;
    h += String("<div class='box'><b class='") + (fresh ? "ok'>ROBOT HIDUP" : "bad'>TIDAK ADA LAPORAN") + "</b><div class='small'>Laporan terakhir " + String(age) + " detik lalu</div></div>";
    h += "<div class='box'>";
    h += String("<div class='row'><span>Versi program</span><span>") + historyEscapeHtml(robotVer) + "</span></div>";
    uint32_t u = robotUptime;
    h += String("<div class='row'><span>Menyala sejak</span><span>") + String(u / 3600) + " jam " + String((u / 60) % 60) + " menit</span></div>";
    const char* rc = robotRssi >= -67 ? "ok" : (robotRssi >= -75 ? "mid" : "bad");
    h += String("<div class='row'><span>Sinyal Wi-Fi</span><span class='") + rc + "'>" + String(robotRssi) + " dBm (" + robotRssiLabel(robotRssi) + "), kanal " + String(robotChan) + "</span></div>";
    h += String("<div class='row'><span>Gemini</span><span class='") + (robotWs ? "ok'>tersambung" : "mid'>tidak tersambung") + "</span></div>";
    h += String("<div class='row'><span>Gemini putus sejak nyala</span><span>") + String(robotDrops) + " kali</span></div>";
    const char* mc = robotRamMin < 20000 ? "bad" : (robotRamMin < 40000 ? "mid" : "ok");
    h += String("<div class='row'><span>Memori cepat (bebas)</span><span>") + String(robotRam / 1024) + " KB</span></div>";
    h += String("<div class='row'><span>Memori cepat (terendah)</span><span class='") + mc + "'>" + String(robotRamMin / 1024) + " KB</span></div>";
    h += String("<div class='row'><span>Memori besar (PSRAM)</span><span>") + String(robotPsram / 1024) + " KB</span></div>";
    if (robotMicPeak >= 0) {
      if (robotMicPeak == 0) {
        h += "<div class='row'><span>Suara mic (1 menit)</span><span class='small'>tidak ada percakapan</span></div>";
      } else {
        long pct = robotMicPeak * 100L / 32767L;
        const char* mcc = robotMicClip > 30 ? "bad" : (robotMicClip > 5 ? "mid" : "ok");
        const char* nilai = robotMicClip > 30 ? "terlalu keras / pecah" : (robotMicClip > 5 ? "agak keras" : (pct < 12 ? "pelan" : "normal"));
        h += String("<div class='row'><span>Suara mic (1 menit)</span><span class='") + mcc + "'>puncak " + String(pct) + "%, pecah " + String(robotMicClip) + " kali (" + nilai + ")</span></div>";
      }
    }
    h += "</div>";
  }
  server.sendContent(h); h = "";

  // Grafik sinyal (SVG): paling lama di kiri, -90 dBm di bawah, -30 dBm di atas
  if (robotSampleCount >= 2) {
    h += "<div class='box'><b>Sinyal Wi-Fi (" + String(robotSampleCount) + " laporan terakhir)</b><svg viewBox='0 0 300 80' width='100%' height='90' style='margin-top:8px'>";
    h += "<rect x='0' y='0' width='300' height='80' fill='#181b22'/>";
    h += "<line x1='0' y1='40' x2='300' y2='40' stroke='#2c303a'/><text x='3' y='11' fill='#6b7280' font-size='9'>-30</text><text x='3' y='77' fill='#6b7280' font-size='9'>-90</text>";
    h += "<polyline fill='none' stroke='#60a5fa' stroke-width='2' points='";
    int first = (robotSampleCount < ROBOT_SAMPLE_MAX) ? 0 : robotSampleNext;
    for (int i = 0; i < robotSampleCount; ++i) {
      const RobotSample& s = robotSamples[(first + i) % ROBOT_SAMPLE_MAX];
      int r = s.rssi; if (r == 0) r = -90;
      float y = 80.0f - (constrain(r, -90, -30) + 90) * (80.0f / 60.0f);
      float x = (float)i * 300.0f / (float)(robotSampleCount - 1);
      h += String(x, 1) + "," + String(y, 1) + " ";
    }
    h += "'/></svg></div>";
    // Tren memori cepat: kalau garis turun terus dari jam ke jam = ada kebocoran memori
    uint16_t rmax = 1; int first2 = (robotSampleCount < ROBOT_SAMPLE_MAX) ? 0 : robotSampleNext;
    for (int i = 0; i < robotSampleCount; ++i) { uint16_t v = robotSamples[(first2 + i) % ROBOT_SAMPLE_MAX].ramKb; if (v > rmax) rmax = v; }
    h += "<div class='box'><b>Memori cepat bebas (KB)</b><svg viewBox='0 0 300 80' width='100%' height='90' style='margin-top:8px'><rect width='300' height='80' fill='#181b22'/>";
    h += "<text x='3' y='11' fill='#6b7280' font-size='9'>" + String(rmax) + "</text><text x='3' y='77' fill='#6b7280' font-size='9'>0</text>";
    h += "<polyline fill='none' stroke='#34d399' stroke-width='2' points='";
    for (int i = 0; i < robotSampleCount; ++i) {
      uint16_t v = robotSamples[(first2 + i) % ROBOT_SAMPLE_MAX].ramKb;
      float y = 80.0f - (float)v * 78.0f / (float)rmax;
      float x = (float)i * 300.0f / (float)(robotSampleCount - 1);
      h += String(x, 1) + "," + String(y, 1) + " ";
    }
    h += "'/></svg></div>";
    server.sendContent(h); h = "";
  }

  // Kejadian dari file: hitung 24 jam terakhir + 30 terbaru
  if (!historyFsReady) {
    server.sendContent("<div class='box small'>Penyimpanan file tidak tersedia, kejadian tidak bisa dicatat.</div>");
  } else {
    int cnt = 0, next = 0, gem24 = 0, wifi24 = 0, boot24 = 0, normal24 = 0;
    int act[4] = {0, 0, 0, 0};            // bicara, mikir, tidur, lain
    long sesiSum = 0, sesiMin = -1; int sesiN = 0;
    int perHour[24]; for (int i = 0; i < 24; ++i) perHour[i] = 0;
    time_t now = time(nullptr); bool timeOk = now >= 1700000000L;
    char line[160];
    File f = LittleFS.open(ROBOT_EVT_FILE, "r");
    if (f) {
      while (f.available()) {
        size_t g = f.readBytesUntil('\n', line, sizeof(line) - 1); line[g] = '\0';
        if (g < 6) continue;
        char* fld[7]; int nf = robotSplit(line, fld, 7);
        if (nf < 5) continue;
        RobotEvtRow& r = robotEvtRows[next];
        r.ts = strtoul(fld[0], nullptr, 10); r.rssi = atoi(fld[2]); r.ram = strtoul(fld[3], nullptr, 10);
        strncpy(r.kind, fld[1], sizeof(r.kind) - 1); r.kind[sizeof(r.kind) - 1] = '\0';
        strncpy(r.detail, nf >= 6 ? fld[5] : "", sizeof(r.detail) - 1); r.detail[sizeof(r.detail) - 1] = '\0';
        next = (next + 1) % 30; if (cnt < 30) ++cnt;
        if (timeOk && r.ts >= 1700000000UL && (uint32_t)now >= r.ts && (uint32_t)now - r.ts < 86400UL) {
          if (!strcmp(r.kind, "gemini_putus")) {
            char tmp[48]; strncpy(tmp, r.detail, sizeof(tmp) - 1); tmp[sizeof(tmp) - 1] = '\0';
            char* d[5]; bool parsed = robotSplit2(tmp, d, 5) >= 5;
            if (parsed && !strcmp(d[0], "cl") && atoi(d[2]) == 1000) {
              ++normal24;   // ditutup normal (robot istirahat): bukan gangguan
            } else {
              ++gem24; ++perHour[((uint32_t)now - r.ts) / 3600];
              if (parsed) {
                long sd = atol(d[3]); ++sesiN; sesiSum += sd; if (sesiMin < 0 || sd < sesiMin) sesiMin = sd;
                if (!strcmp(d[4], "bicara")) ++act[0]; else if (!strcmp(d[4], "mikir")) ++act[1]; else if (!strcmp(d[4], "tidur")) ++act[2]; else ++act[3];
              }
            }
          }
          else if (!strcmp(r.kind, "wifi_putus")) ++wifi24;
          else if (!strncmp(r.kind, "boot_", 5) || !strcmp(r.kind, "restart_macet")) ++boot24;
        }
      }
      f.close();
    }
    h += "<div class='box'><b>24 jam terakhir</b>";
    if (!timeOk) h += "<div class='small'>Jam DevKit belum tersedia, hitungan belum bisa.</div>";
    else {
      h += "<div class='row'><span>Gemini ditutup normal (istirahat)</span><span class='ok'>" + String(normal24) + " kali</span></div>";
      h += "<div class='row'><span>Gemini putus (gangguan)</span><span class='" + String(gem24 > 10 ? "bad" : (gem24 > 3 ? "mid" : "ok")) + "'>" + String(gem24) + " kali</span></div>";
      h += "<div class='row'><span>Wi-Fi putus</span><span class='" + String(wifi24 > 3 ? "bad" : "ok") + "'>" + String(wifi24) + " kali</span></div>";
      h += "<div class='row'><span>Robot nyala ulang / restart</span><span class='" + String(boot24 > 2 ? "mid" : "ok") + "'>" + String(boot24) + " kali</span></div>";
      if (sesiN > 0) {
        h += "<div class='row'><span>Sesi Gemini bertahan (rata-rata)</span><span>" + robotMenit(sesiSum / sesiN) + "</span></div>";
        h += "<div class='row'><span>Sesi terpendek sebelum putus</span><span>" + robotMenit(sesiMin) + "</span></div>";
        h += "<div class='row'><span>Gemini putus saat</span><span class='small'>bicara " + String(act[0]) + " · mikir " + String(act[1]) + " · tidur " + String(act[2]) + " · lain " + String(act[3]) + "</span></div>";
      }
      int mx = 1; for (int i = 0; i < 24; ++i) if (perHour[i] > mx) mx = perHour[i];
      h += "<div class='small' style='margin-top:8px'>Gemini putus per jam (kiri = 24 jam lalu, kanan = sekarang)</div><svg viewBox='0 0 240 40' width='100%' height='50'><rect width='240' height='40' fill='#181b22'/>";
      for (int i = 0; i < 24; ++i) {
        int v = perHour[23 - i];
        if (v > 0) { int bh = 4 + (v * 32) / mx; h += "<rect x='" + String(i * 10 + 1) + "' y='" + String(40 - bh) + "' width='8' height='" + String(bh) + "' fill='#f87171'/>"; }
      }
      h += "</svg>";
    }
    h += "</div>";
    server.sendContent(h); h = "";

    h += "<div class='box'><b>Kejadian terakhir</b>";
    if (cnt == 0) h += "<div class='small'>Belum ada kejadian tercatat.</div>";
    int start = (cnt < 30) ? 0 : next;
    for (int i = cnt - 1; i >= 0; --i) {
      const RobotEvtRow& r = robotEvtRows[(start + i) % 30];
      bool bad = !strcmp(r.kind, "boot_crash") || !strcmp(r.kind, "boot_brownout") || !strcmp(r.kind, "restart_macet");
      h += "<div class='row'><span class='" + String(bad ? "bad" : "") + "'>" + robotKindText(r.kind) + "<div class='small'>" + historyFormatTime(r.ts) + "</div><div class='small'>" + historyEscapeHtml(robotDetailText(r.kind, r.detail).c_str()) + "</div></span><span class='small'>" + String(r.rssi) + " dBm · " + String(r.ram / 1024) + " KB</span></div>";
      if (h.length() > 1500) { server.sendContent(h); h = ""; }
    }
    h += "</div>";
  }
  h += "<a class='back' style='background:#7f1d1d' href='/robot_clear' onclick=\"return confirm('Hapus semua catatan kejadian robot?')\">Hapus catatan kejadian</a>";
  h += "</div></body></html>";
  server.sendContent(h);
  server.sendContent("");
}

