void handleHistory() {
  uint8_t order[HISTORY_MAX_ENTRIES], starts[HISTORY_MAX_ENTRIES], ends[HISTORY_MAX_ENTRIES];
  uint8_t count = 0;
  uint8_t first = (uint8_t)((historyNext + HISTORY_MAX_ENTRIES - historyCount) % HISTORY_MAX_ENTRIES);
  for (uint8_t n = 0; n < historyCount; ++n) order[n] = (uint8_t)((first + n) % HISTORY_MAX_ENTRIES);
  for (uint8_t n = 0; n < historyCount; ++n) {
    bool newSession = (n == 0);
    if (n > 0) {
      uint32_t prev = historyEntries[order[n - 1]].timestamp;
      uint32_t now = historyEntries[order[n]].timestamp;
      newSession = (now > prev && now - prev > 300);
    }
    if (newSession) { starts[count] = n; if (count > 0) ends[count - 1] = n - 1; ++count; }
  }
  if (count > 0) ends[count - 1] = historyCount - 1;

  String h = "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>";
  h += "<style>body{margin:0;padding:16px;background:#111318;color:#e7e9ef;font:16px Arial,sans-serif}.wrap{max-width:760px;margin:auto}.item{background:#20232b;border:1px solid #343844;border-radius:12px;padding:14px;margin:10px 0;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere}.u{border-left:4px solid #60a5fa}.a{border-left:4px solid #34d399}.meta{font-size:12px;color:#9ca3af;margin-bottom:8px}.back,.open{display:block;color:#fff;background:#343844;padding:12px;border-radius:9px;text-decoration:none;margin:10px 0}.open{background:#20232b;border:1px solid #343844}.small{font-size:13px;color:#9ca3af;margin-top:6px}</style></head><body><div class='wrap'>";
  if (server.hasArg("session")) {
    uint32_t wanted = (uint32_t)server.arg("session").toInt();
    int selected = -1;
    for (uint8_t g = 0; g < count; ++g) {
      uint32_t stamp = historyEntries[order[starts[g]]].timestamp;
      if (stamp == wanted) { selected = g; break; }
    }
    h += "<a class='back' href='/history'>← Semua riwayat</a><h2>Detail Percakapan</h2>";
    if (selected < 0) h += "<div class='item'>Sesi tidak ditemukan atau sudah tergeser oleh riwayat terbaru.</div>";
    else {
      for (uint8_t n = starts[selected]; n <= ends[selected]; ++n) {
        const HistoryEntry &e = historyEntries[order[n]];
        h += String("<div class='item ") + (e.role == 'U' ? "u" : "a") + "'><div class='meta'>" + (e.role == 'U' ? "PENGGUNA" : "GEMINI") + " · " + historyFormatTime(e.timestamp) + "</div>" + historyEscapeHtml(e.text) + "</div>";
      }
    }
  } else {
    h += "<a class='back' href='/'>← Kembali ke kontrol</a><h2>Riwayat Percakapan Robot</h2>";
    h += "<p>" + String(count) + " sesi terdeteksi · " + String(historyCount) + " pesan tersimpan.</p>";
    if (count == 0) h += "<div class='item'>Belum ada riwayat. Ucapkan sesuatu kepada robot setelah koneksi UART aktif.</div>";
    for (int g = (int)count - 1; g >= 0; --g) {
      const HistoryEntry &firstEntry = historyEntries[order[starts[g]]];
      const HistoryEntry *titleEntry = &firstEntry;
      for (uint8_t n = starts[g]; n <= ends[g]; ++n) {
        if (historyEntries[order[n]].role == 'U') { titleEntry = &historyEntries[order[n]]; break; }
      }
      uint32_t sessionId = firstEntry.timestamp;
      h += String("<a class='open' href='/history?session=") + String(sessionId) + "'><strong>" + historyEscapeHtml(titleEntry->text) + "</strong><div class='small'>" + historyFormatTime(sessionId) + " · " + String(ends[g] - starts[g] + 1) + " pesan</div></a>";
    }
  }
  h += "</div></body></html>"; server.send(200, "text/html; charset=utf-8", h);
}

void handleUpdateData() {
  String txtLdr = (analogRead(PIN_LDR) > 100) ? "MENYALA" : "MATI";
  String response = "TIME : " + ambilWaktu();
  response += "<br>SUHU : " + String(dataSuhu, 1) + " C";
  response += "<br>LAMPU: " + txtLdr;
  response += "<br>STAT : " + statusSistem;
  server.send(200, "text/plain", response);
}

void handleKirim() {
  bunyikanBuzzer(3, 60, 60);
  String a = server.arg("a");
  String t = server.arg("t");

  if (a == "k") {
    if (t == "p")      setFan(!statusKipas);
    else if (t == "s") irsend.sendSymphony(0xD82, 12, 2);
    else if (t == "w") irsend.sendSymphony(0xD90, 12, 2);
    else if (t == "m") irsend.sendSymphony(0xDA0, 12, 2);
    statusSistem = "IR: Kipas Sent";
  } else if (a == "m") {
    if (t == "m")      irsend.sendNEC(0x00FF22DD, 32);
    else if (t == "l") irsend.sendNEC(0x00FF906F, 32);
    else if (t == "e") irsend.sendNEC(0x00FFC23D, 32);
    else {
      int idx = t.toInt();
      if (idx >= 0 && idx <= 9) irsend.sendNEC(kodeLagu[idx], 32);
    }
    statusSistem = "IR: MP3 Sent (" + t + ")";
  }

  server.sendHeader("Location", "/");
  server.send(302, "text/plain", "");
}

void handleRelayWeb() {
  bunyikanBuzzer(3, 60, 60);
  String id = server.arg("id");

  if (id == "1") {
    setRelay(1, !statusRelay1);
    statusSistem = "IR TX: colokan Diubah";
  } else if (id == "2") {
