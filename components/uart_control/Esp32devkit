// Hasil pencarian web yang diterima melalui UART (maks. 3000 byte).
static const size_t WEB_SEARCH_MAX_BYTES = 3000;
char webSearchResult[WEB_SEARCH_MAX_BYTES + 1] = {};
size_t webSearchExpected = 0;
size_t webSearchReceived = 0;
bool webSearchFrameActive = false;
bool webSearchComplete = false;
String webSearchStatus = "Belum ada hasil pencarian";

void prosesFrameWebSearch(const char* line) {
  if (!line) return;

  if (strncmp(line, "WSRCH|BEGIN|", 12) == 0) {
    char* end = nullptr;
    unsigned long total = strtoul(line + 12, &end, 10);
    if (end == line + 12 || *end != '\0' || total > WEB_SEARCH_MAX_BYTES) {
      webSearchFrameActive = false;
      webSearchComplete = false;
      webSearchStatus = "Frame pencarian tidak valid";
      return;
    }
    memset(webSearchResult, 0, sizeof(webSearchResult));
    webSearchExpected = (size_t)total;
    webSearchReceived = 0;
    webSearchFrameActive = true;
    webSearchComplete = false;
    webSearchStatus = "Menerima hasil pencarian...";
    return;
  }

  if (strcmp(line, "WSRCH|END") == 0) {
    webSearchFrameActive = false;
    webSearchComplete = (webSearchReceived == webSearchExpected);
    if (webSearchComplete) {
      // UART frames use byte 0x1E as a safe stand-in for newline.
      for (size_t i = 0; i < webSearchReceived; ++i) {
        if ((unsigned char)webSearchResult[i] == 0x1E) webSearchResult[i] = '\n';
      }
      webSearchResult[webSearchReceived] = '\0';
    }
    webSearchStatus = webSearchComplete
      ? "Hasil pencarian diterima"
      : "Hasil pencarian tidak lengkap";
    statusSistem = webSearchStatus;
    Serial.printf("WSRCH: %u/%u byte, complete=%d\n",
                  (unsigned)webSearchReceived, (unsigned)webSearchExpected,
                  webSearchComplete ? 1 : 0);
    return;
  }

  if (strncmp(line, "WSRCH|DATA|", 11) == 0) {
    if (!webSearchFrameActive) return;
    const char* offsetText = line + 11;
    char* end = nullptr;
    unsigned long offset = strtoul(offsetText, &end, 10);
    if (end == offsetText || *end != '|') return;

    const char* payload = end + 1;
    size_t payloadLen = strlen(payload);
    if (offset != webSearchReceived ||
        offset > webSearchExpected ||
        payloadLen > webSearchExpected - offset ||
        payloadLen > WEB_SEARCH_MAX_BYTES - offset) {
      webSearchFrameActive = false;
      webSearchStatus = "Urutan atau ukuran data UART tidak valid";
      return;
    }

    memcpy(webSearchResult + offset, payload, payloadLen);
    webSearchReceived += payloadLen;
    webSearchResult[webSearchReceived] = '\0';
  }
}

// RIWAYAT PERCAKAPAN ROBOT
static const uint8_t HISTORY_MAX_ENTRIES = 24;
struct HistoryEntry { uint32_t timestamp; char role; char text[420]; };
HistoryEntry historyEntries[HISTORY_MAX_ENTRIES];
Preferences historyPrefs;
uint8_t historyCount = 0, historyNext = 0;
bool historyPrefsReady = false;
void historyLoad() {
  historyPrefsReady = historyPrefs.begin("robotHist", false);
  if (!historyPrefsReady) return;
  historyCount = (uint8_t)min((uint32_t)HISTORY_MAX_ENTRIES, historyPrefs.getUInt("count", 0));
  historyNext = (uint8_t)(historyPrefs.getUInt("next", 0) % HISTORY_MAX_ENTRIES);
  for (uint8_t i = 0; i < HISTORY_MAX_ENTRIES; ++i) {
    char key[5]; snprintf(key, sizeof(key), "h%02u", i);
    if (historyPrefs.getBytesLength(key) == sizeof(HistoryEntry)) historyPrefs.getBytes(key, &historyEntries[i], sizeof(HistoryEntry));
    else memset(&historyEntries[i], 0, sizeof(HistoryEntry));
  }
}
void historyFileAppend(char role, const char* message);
void historyAppend(char role, const char* message) {
  historyFileAppend(role, message);
  if (!historyPrefsReady || !message || !message[0]) return;
  HistoryEntry entry = {};
  entry.timestamp = (uint32_t)time(nullptr); entry.role = role;
  strlcpy(entry.text, message, sizeof(entry.text));
  historyEntries[historyNext] = entry;
  char key[5]; snprintf(key, sizeof(key), "h%02u", historyNext);
  historyPrefs.putBytes(key, &entry, sizeof(entry));
  historyNext = (uint8_t)((historyNext + 1) % HISTORY_MAX_ENTRIES);
  if (historyCount < HISTORY_MAX_ENTRIES) ++historyCount;
  historyPrefs.putUInt("next", historyNext); historyPrefs.putUInt("count", historyCount);
}
// =====================================================
// RIWAYAT PANJANG DI FILE (LittleFS)
// File teks /hist.log, satu baris per pesan:  <epoch>|<U atau A>|<teks>
// Kalau file melewati HIST_FILE_MAX, separuh bagian paling lama dibuang (sistem cincin).
// Jika LittleFS tidak tersedia (skema partisi tanpa SPIFFS), program memakai riwayat NVS 24 pesan seperti sebelumnya.
// =====================================================
static const char* HIST_FILE = "/hist.log";
static const char* HIST_TMP = "/hist.tmp";
static const size_t HIST_FILE_MAX = 72 * 1024;   // sekitar 300 pesan
static const size_t HIST_TEXT_MAX = 200;         // byte teks per pesan di file
static const long HIST_TZ_SEC = 8 * 3600;        // WITA, sama dengan configTime di konfigurasiNTP()
bool historyFsReady = false;

void historyFsBegin() {
  historyFsReady = LittleFS.begin(true);   // true = format otomatis jika belum ada filesystem
  Serial.println(historyFsReady ? "Riwayat file: LittleFS siap" : "Riwayat file: LittleFS tidak ada, pakai NVS 24 pesan");
}

static void historyFileTrim() {
  File src = LittleFS.open(HIST_FILE, "r");
  if (!src) return;
  size_t size = src.size();
  if (size <= HIST_FILE_MAX) { src.close(); return; }
  src.seek(size / 2);
  while (src.available()) { int c = src.read(); if (c < 0 || c == '\n') break; }   // buang baris yang terpotong
  File dst = LittleFS.open(HIST_TMP, "w");
  if (!dst) { src.close(); return; }
  uint8_t buf[256];
  while (src.available()) {
    size_t n = src.read(buf, sizeof(buf));
    if (n == 0) break;
    dst.write(buf, n);
  }
  src.close(); dst.close();
  LittleFS.remove(HIST_FILE);
  LittleFS.rename(HIST_TMP, HIST_FILE);
}

void historyFileAppend(char role, const char* message) {
  if (!historyFsReady || !message || !message[0]) return;
  size_t len = strlen(message);
  if (len > HIST_TEXT_MAX) {
    len = HIST_TEXT_MAX;
    while (len > 0 && (((unsigned char)message[len]) & 0xC0) == 0x80) --len;   // jangan potong tengah huruf UTF-8
  }
  char line[HIST_TEXT_MAX + 32];
  int n = snprintf(line, sizeof(line), "%lu|%c|", (unsigned long)time(nullptr), role == 'A' ? 'A' : 'U');
  for (size_t i = 0; i < len && n < (int)sizeof(line) - 2; ++i) {
    char c = message[i];
    line[n++] = (c == '\n' || c == '\r') ? ' ' : c;
  }
  line[n++] = '\n';
  File f = LittleFS.open(HIST_FILE, "a");
  if (!f) return;
  f.write((const uint8_t*)line, (size_t)n);
  size_t size = f.size();
  f.close();
  if (size > HIST_FILE_MAX) historyFileTrim();
}

// Urai satu baris file: "<epoch>|<U/A>|<teks>". Mengembalikan false jika bentuknya salah.
bool historyParseLine(char* buf, uint32_t* ts, char* role, const char** text) {
  char* e = nullptr;
  unsigned long v = strtoul(buf, &e, 10);
  if (e == buf || e[0] != '|' || (e[1] != 'U' && e[1] != 'A') || e[2] != '|') return false;
  *ts = (uint32_t)v; *role = e[1]; *text = e + 3;
  return true;
}

struct HistRow { uint32_t ts; char role; char text[HIST_TEXT_MAX + 4]; };
static const int HIST_REQ_MAX = 12;
static HistRow histRows[HIST_REQ_MAX];   // statis: tidak membebani stack

// Baca pesan terakhir dari file (paling banyak 'n'). hariLalu < 0 = semua hari; 0 = hari ini; 1 = kemarin; dst.
// Hasil ada di histRows (urut dari paling lama ke paling baru). Mengembalikan jumlahnya.
int historyFileRead(int n, int hariLalu) {
  if (!historyFsReady || n < 1) return 0;
  if (n > HIST_REQ_MAX) n = HIST_REQ_MAX;
  long targetDay = -1;
  if (hariLalu >= 0) {
    time_t now = time(nullptr);
    if (now < 1700000000L) return 0;   // jam belum tersedia: tidak bisa memilih hari
    targetDay = ((long)now + HIST_TZ_SEC) / 86400L - hariLalu;
  }
  File f = LittleFS.open(HIST_FILE, "r");
  if (!f) return 0;
  int total = 0;
  char buf[HIST_TEXT_MAX + 40];
  while (f.available()) {
    size_t got = f.readBytesUntil('\n', buf, sizeof(buf) - 1);
    buf[got] = '\0';
    if (got == 0) continue;
    uint32_t ts = 0; char role = 'U'; const char* text = nullptr;
    if (!historyParseLine(buf, &ts, &role, &text)) continue;
    if (targetDay >= 0 && ((long)ts + HIST_TZ_SEC) / 86400L != targetDay) continue;
    HistRow& r = histRows[total % n];
    r.ts = ts;
    r.role = role;
    strlcpy(r.text, text, sizeof(r.text));
    ++total;
  }
  f.close();
  int count = total < n ? total : n;
  // Susun ulang dari paling lama ke paling baru bila cincin sudah berputar.
  if (total > n) {
    static HistRow tmp[HIST_REQ_MAX];
    int start = total % n;
    for (int i = 0; i < n; ++i) tmp[i] = histRows[(start + i) % n];
    for (int i = 0; i < n; ++i) histRows[i] = tmp[i];
  }
  return count;
}

// Robot minta riwayat: HISTREQ|<n>  atau  HISTREQ|<n>|<hari_lalu>
// Balasan lewat Serial2: HISTRES|BEGIN|<jumlah>, HISTRES|ITEM|<umur_menit atau -1>|<U/A>|<teks> (diulang), HISTRES|END
void kirimRiwayatKeRobot(int n, int hariLalu) {
  if (n < 1) n = 1;
  if (n > HIST_REQ_MAX) n = HIST_REQ_MAX;
  int count = 0;
  if (historyFsReady) {
    count = historyFileRead(n, hariLalu);
  } else if (hariLalu < 0) {
    // Cadangan: riwayat NVS lama (24 pesan).
    count = n < (int)historyCount ? n : (int)historyCount;
    const uint8_t first = (uint8_t)((historyNext + HISTORY_MAX_ENTRIES - count) % HISTORY_MAX_ENTRIES);
    for (int i = 0; i < count; ++i) {
      const HistoryEntry& e = historyEntries[(first + i) % HISTORY_MAX_ENTRIES];
      histRows[i].ts = e.timestamp;
      histRows[i].role = e.role;
      strlcpy(histRows[i].text, e.text, sizeof(histRows[i].text));
    }
  }
  Serial2.print("HISTRES|BEGIN|"); Serial2.println(count);
  const uint32_t now = (uint32_t)time(nullptr);
  for (int i = 0; i < count; ++i) {
    const HistRow& r = histRows[i];
    long umur = -1;
    if (now >= 1700000000UL && r.ts >= 1700000000UL && now >= r.ts) umur = (long)((now - r.ts) / 60);
    size_t len = strlen(r.text);
    if (len > 180) {
      len = 180;
      while (len > 0 && (((unsigned char)r.text[len]) & 0xC0) == 0x80) --len;
    }
    char teks[184];
    memcpy(teks, r.text, len);
    teks[len] = '\0';
    for (size_t k = 0; k < len; ++k) {
      if (teks[k] == '|' || teks[k] == '\r' || teks[k] == '\n') teks[k] = ' ';
    }
    Serial2.print("HISTRES|ITEM|"); Serial2.print(umur); Serial2.print('|');
    Serial2.print(r.role == 'A' ? 'A' : 'U'); Serial2.print('|');
    Serial2.println(teks);
  }
  Serial2.println("HISTRES|END");
}

String historyEscapeHtml(const char* value) {
  String out; if (!value) return out;
  for (const char* p = value; *p; ++p) {
    if (*p == '&') out += "&amp;";
    else if (*p == '<') out += "&lt;";
    else if (*p == '>') out += "&gt;";
    else if (*p == '"') out += "&quot;";
    else if ((unsigned char)*p == 39) out += "&#39;";
    else out += *p;
  }
  return out;
}
String historyFormatTime(uint32_t stamp) {
  if (stamp < 1700000000UL) return String("Waktu belum tersedia");
  time_t raw = (time_t)stamp; struct tm info; localtime_r(&raw, &info);
  char buf[24]; strftime(buf, sizeof(buf), "%d/%m/%Y %H:%M", &info); return String(buf);
}

