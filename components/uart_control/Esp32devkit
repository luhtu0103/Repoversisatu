// =====================================================
// SENSOR
// =====================================================
void bacaSensorSuhu() {
  int nilaiAnalogNTC = analogRead(PIN_NTC);

  if (nilaiAnalogNTC > 0 && nilaiAnalogNTC < 4095) {
    float resistansi = 10000.0 * ((4095.0 / (float)nilaiAnalogNTC) - 1.0);

    if (resistansi > 0) {
      float logResistansi = log(resistansi);
      float tempK = 1.0 / (0.001129148 +
      (0.000234125 * logResistansi) +
      (0.0000000876741 * logResistansi * logResistansi * logResistansi));
      float tempC = tempK - 273.15;
      tempC += 4.0;
      if (tempC > -10 && tempC < 60) dataSuhu = tempC;
    }
  }
}

// =====================================================
// NTP + OLED AUTO (mengikuti NTP)
// =====================================================
void konfigurasiNTP() {
  if (WiFi.status() != WL_CONNECTED) return;
  configTime(8 * 3600, 0, "pool.ntp.org", "time.google.com", "time.nist.gov");
  ntpKonfigurasiTerakhir = millis();
  ntpSudahDikonfigurasi = true;
}

bool waktuNTPValid(time_t now) {
  return now >= NTP_MIN_VALID;
}

void prosesNTP() {
  if (WiFi.status() != WL_CONNECTED) {
    ntpSudahDikonfigurasi = false;
    return;
  }
  if (!ntpSudahDikonfigurasi ||
  millis() - ntpKonfigurasiTerakhir >= NTP_RESYNC_INTERVAL) {
    konfigurasiNTP();
  }
}

void prosesJadwalOLED(time_t sekarang) {
  if (sekarang < 50000) return;

  if (waktuOLEDTerakhir == 0) {
    waktuOLEDTerakhir = sekarang;
    return;
  }
  if (sekarang <= waktuOLEDTerakhir) {
    waktuOLEDTerakhir = sekarang;
    return;
  }

  time_t awalHari = awalHariDari(sekarang);
  time_t targetMati   = awalHari + 60;
  time_t targetBangun = awalHari + 4 * 3600L + 60;

  if (targetMati > waktuOLEDTerakhir && targetMati <= sekarang) {
    sendIRSignal(0x00FFE01F);
    sudahKirimMatiOLED = true;
    sudahKirimBangunOLED = false;
    Serial.println("OLED: PERINTAH MATI TERKIRIM");
  }

  if (targetBangun > waktuOLEDTerakhir && targetBangun <= sekarang) {
    sendIRSignal(0x00FFE41B);
    sudahKirimBangunOLED = true;
    sudahKirimMatiOLED = false;
    Serial.println("OLED: PERINTAH BANGUN TERKIRIM");
  }

  waktuOLEDTerakhir = sekarang;
}

// =====================================================
// SERIAL2
// =====================================================
void eksekusiTeksPerintah(String cmd);

void prosesSerial2() {
  while (Serial2.available()) {
    char c = (char)Serial2.read();

    if (c == '\r') continue;

    if (c == '\n') {
      serial2Buffer[serial2Pos] = '\0';
      if (serial2Pos > 0) {
        eksekusiTeksPerintah(String(serial2Buffer));
      }
      serial2Pos = 0;
      continue;
    }

    if (serial2Pos < sizeof(serial2Buffer) - 1) {
      serial2Buffer[serial2Pos++] = c;
    } else {
      serial2Pos = 0;
      statusSistem = "Serial2: command terlalu panjang";
    }
  }
}

// =====================================================
// COMMAND EXECUTION (dari CODE 2)
// =====================================================
void eksekusiTeksPerintah(String cmd) {
  cmd.trim();
  if (cmd.length() == 0) return;
  if (cmd.startsWith("HISTU:")) { historyAppend('U', cmd.substring(6).c_str()); return; }
  if (cmd.startsWith("HISTA:")) { historyAppend('A', cmd.substring(6).c_str()); return; }

  bool dikenali = true;

  // --- SENSOR (balas via Serial2) ---
  if (cmd == "cek_suhu") {
    bacaSensorSuhu();
    Serial2.print("SUHU:");
    Serial2.println(dataSuhu, 1);
    statusSistem = "Sensor: Suhu (" + String(dataSuhu, 1) + " C)";
    bunyikanBuzzer(1, 60, 0);
    return;
  }
  if (cmd == "cek_cahaya") {
    int nilaiMentahLDR = analogRead(PIN_LDR);
    Serial2.print("CAHAYA:");
    Serial2.println(nilaiMentahLDR);
    statusSistem = "Sensor: Raw LDR (" + String(nilaiMentahLDR) + ")";
    bunyikanBuzzer(1, 60, 0);
    return;
  }

  // --- RELAY ON/OFF EKSPLISIT ---
  if      (cmd == "r1_on")  setRelay(1, true);
  else if (cmd == "r1_off") setRelay(1, false);
  else if (cmd == "r2_on")  setRelay(2, true);
  else if (cmd == "r2_off") setRelay(2, false);
  else if (cmd == "r3_on")  setRelay(3, true);
  else if (cmd == "r3_off") setRelay(3, false);
  else if (cmd == "r4_on")  setRelay(4, true);
  else if (cmd == "r4_off") setRelay(4, false);

  // --- TOGGLE ---
  else if (cmd == "r1") setRelay(1, !statusRelay1);
  else if (cmd == "r2") setRelay(2, !statusRelay2);
  else if (cmd == "r3") setRelay(3, !statusRelay3);
  else if (cmd == "r4") setRelay(4, !statusRelay4);

  // --- KIPAS ---
  else if (cmd == "fan_on")    setFan(true);
  else if (cmd == "fan_off")   setFan(false);
  else if (cmd == "fan_pwr")   setFan(!statusKipas);
  else if (cmd == "fan_speed") irsend.sendSymphony(0xD82, 12, 2);
  else if (cmd == "fan_swing") irsend.sendSymphony(0xD90, 12, 2);
  else if (cmd == "fan_mode")  irsend.sendSymphony(0xDA0, 12, 2);

  // --- MOCHI ---
  else if (cmd == "m_led")   sendIRSignal(0x00FF12ED);
  else if (cmd == "m_mute")  sendIRSignal(0x00FF0AF5);
  else if (cmd == "m_musik") sendIRSignal(0x00FF827D);
  else if (cmd == "m_cek")   sendIRSignal(0x00FF708F);

  // --- MP3 ---
  else if (cmd == "mp3_mode") sendIRSignal(0x00FF22DD);
  else if (cmd == "mp3_play") sendIRSignal(0x00FF906F);
  else if (cmd == "mp3_eq")   sendIRSignal(0x00FFC23D);

  // --- LAGU 0-9 ---
  else if (cmd.length() == 1 && cmd.charAt(0) >= '0' && cmd.charAt(0) <= '9') {
    int idx = cmd.toInt();
    sendIRSignal(kodeLagu[idx]);
  }
  else {
    dikenali = false;
  }

  if (!dikenali) {
    Serial2.println("ERR");
    statusSistem = "Perintah [" + cmd + "] Tidak Dikenal";
    bunyikanBuzzer(1, 60, 0);
    return;
  }

  statusSistem = "Perintah [" + cmd + "] Sukses";
  bunyikanBuzzer(1, 100, 0);
}

