  }

  server.sendHeader("Location", "/");
  server.send(302, "text/plain", "");
}

void handleMochiWeb() {
  bunyikanBuzzer(3, 60, 60);
  String cmd = server.arg("cmd");

  if (cmd == "led")        { sendIRSignal(0x00FF12ED); statusSistem = "IR TX: Strobo Mochi"; }
  else if (cmd == "mute")  { sendIRSignal(0x00FF0AF5); statusSistem = "IR TX: Mute Mochi"; }
  else if (cmd == "musik") { sendIRSignal(0x00FF827D); statusSistem = "IR TX: Musik Mochi"; }
  else if (cmd == "cek")   { sendIRSignal(0x00FF708F); statusSistem = "IR TX: Cek HW Mochi"; }

  server.sendHeader("Location", "/");
  server.send(302, "text/plain", "");
}

// =====================================================
// WIFI HANDLING
// =====================================================
void handleWiFiDenganPrioritas() {
  unsigned long nowMillis = millis();

  if (WiFi.status() != WL_CONNECTED) {
    if (!wifiDalamModeRecovery) {
      wifiDalamModeRecovery = true;
      wifiRecoveryMulai = nowMillis;
      Serial.println("WIFI: Masuk mode recovery");
    }

    if (nowMillis - wifiReconnectTerakhir >= WIFI_RECONNECT_INTERVAL) {
      wifiReconnectTerakhir = nowMillis;
      WiFi.reconnect();

      if (WiFi.status() != WL_CONNECTED &&
      nowMillis - wifiRecoveryMulai > 10000) {
        Serial.println("WIFI: Restart stack WiFi...");
        WiFi.disconnect(true);
        delay(100);
        WiFi.begin(ssid, password);
        wifiRecoveryMulai = nowMillis;
      }
    }

    if (nowMillis - wifiRecoveryMulai > WIFI_RECOVERY_TIMEOUT) {
      wifiDalamModeRecovery = false;
      wifiRecoveryMulai = 0;
      Serial.println("WIFI: Recovery timeout");
    }
    return;
  } else {
    if (wifiDalamModeRecovery) {
      wifiDalamModeRecovery = false;
      wifiRecoveryMulai = 0;
      Serial.println("WIFI: Koneksi pulih");
      waktuKonekWiFi = nowMillis;
    }
  }

  if (cekKualitasWiFi() >= 2) {
    prosesNTP();
  }
}

void handleWebServerDenganTimeout() {
  unsigned long nowMillis = millis();
  if (nowMillis - waktuWebServerTerakhir >= JEDA_WEB_SERVER) {
    waktuWebServerTerakhir = nowMillis;
    server.handleClient();
  }
}

// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);
  Serial2.begin(115200, SERIAL_8N1, 16, 17);  // RX2=16, TX2=17

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);
  WiFi.setSleep(false);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);

  irsend.begin();

  pinMode(PIN_LED_FISIK, OUTPUT);
  digitalWrite(PIN_LED_FISIK, LOW);
  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_BUZZER, LOW);
  pinMode(PIN_LDR, INPUT);
  pinMode(PIN_NTC, INPUT);

  WiFi.begin(ssid, password);

  unsigned long startMulaiWiFi = millis();
  bool gagalKonek = false;

  while (WiFi.status() != WL_CONNECTED) {
    digitalWrite(PIN_LED_FISIK, !digitalRead(PIN_LED_FISIK));
    delay(100);

    if (millis() - startMulaiWiFi > 3000) server.handleClient();
    if (millis() - startMulaiWiFi > 12000) { gagalKonek = true; break; }
  }

  if (gagalKonek) {
    Serial.println("WIFI GAGAL TERHUBUNG");
    bunyikanBuzzer(8, 70, 70);
    Serial.println("Web server tetap aktif di mode offline");
  } else {
    Serial.println("WIFI TERHUBUNG");
    Serial.print("IP ESP32: ");
    Serial.println(WiFi.localIP());
    digitalWrite(PIN_LED_FISIK, HIGH);
    waktuKonekWiFi = millis();
    bunyikanBuzzer(3, 80, 80);
  }

  konfigurasiNTP();
  historyLoad();

  server.on("/history", handleHistory);
  server.on("/", []() { server.send(200, "text/html", halamanWeb()); });
  server.on("/update_data", handleUpdateData);
  server.on("/k", handleKirim);
  server.on("/relay", handleRelayWeb);
  server.on("/mochi", handleMochiWeb);
  server.on("/ping", []() { server.send(200, "text/plain", "OK"); });
  server.begin();

  Serial.println();
  Serial.println("Sistem Pemancar Manual LDR-NTC Siap!");
  Serial.println("Web server aktif, sensor sentuh dihapus");
  Serial.println("Serial2: r1_on, r1_off, rX, fan_on, fan_off, cek_suhu, cek_cahaya");
}

// =====================================================
// MAIN LOOP
// =====================================================
void loop() {
  handleWebServerDenganTimeout();
  prosesSerial2();
  handleWiFiDenganPrioritas();

  time_t now = time(nullptr);

  static unsigned long timerLokalWeb = 0;
  if (millis() - timerLokalWeb >= 3000) {
    timerLokalWeb = millis();
    bacaSensorSuhu();
  }

  // LED fade
  if (WiFi.status() == WL_CONNECTED && cekKualitasWiFi() >= 1) {
    if (!sudahLewatJedaAwal) {
      if (millis() - waktuKonekWiFi >= 4000) {
        analogWrite(PIN_LED_FISIK, 0);
        kecerahanLED = 0;
        arahFade = 5;
        sudahLewatJedaAwal = true;
      }
    } else if (millis() - waktuFadeTerakhir >= jedaFade) {
      waktuFadeTerakhir = millis();
      kecerahanLED += arahFade;
      if (kecerahanLED <= 0 || kecerahanLED >= 255) arahFade = -arahFade;
      analogWrite(PIN_LED_FISIK, constrain(kecerahanLED, 0, 255));
    }
  } else {
    digitalWrite(PIN_LED_FISIK, LOW);
  }

  // OLED mengikuti NTP
  if (waktuNTPValid(now)) {
    prosesJadwalOLED(now);
  }

  prosesBuzzer();
  yield();
}
