void bunyikanBuzzer(int jumlahBip, int durasiBip, int jedaBip) {
  if (jumlahBip <= 0 || durasiBip <= 0) return;
  if (buzzerAktif) return;

  buzzerAktif = true;
  buzzerSedangNyala = true;
  buzzerSisaBip = jumlahBip;
  buzzerDurasi = durasiBip;
  buzzerJeda = jedaBip;
  buzzerTimer = millis();
  digitalWrite(PIN_BUZZER, HIGH);
}

void prosesBuzzer() {
  if (!buzzerAktif) return;

  unsigned long now = millis();

  if (buzzerSedangNyala) {
    if (now - buzzerTimer >= (unsigned long)buzzerDurasi) {
      digitalWrite(PIN_BUZZER, LOW);
      buzzerSedangNyala = false;
      buzzerSisaBip--;
      buzzerTimer = now;
      if (buzzerSisaBip <= 0) buzzerAktif = false;
    }
    return;
  }

  if (buzzerSisaBip > 0) {
    if (now - buzzerTimer >= (unsigned long)buzzerJeda) {
      digitalWrite(PIN_BUZZER, HIGH);
      buzzerSedangNyala = true;
      buzzerTimer = now;
    }
  }
}

String ambilWaktu() {
  time_t now = time(nullptr);
  if (now < 50000) return "--:--:-- (Sinkronisasi...)";

  struct tm t;
  localtime_r(&now, &t);
  char buffer[32];
  snprintf(buffer, sizeof(buffer), "%02d:%02d:%02d", t.tm_hour, t.tm_min, t.tm_sec);
  return String(buffer);
}

time_t awalHariDari(time_t ts) {
  struct tm t;
  localtime_r(&ts, &t);
  t.tm_hour = 0; t.tm_min = 0; t.tm_sec = 0;
  t.tm_isdst = -1;
  return mktime(&t);
}

int cekKualitasWiFi() {
  if (WiFi.status() != WL_CONNECTED) return -1;
  int rssi = WiFi.RSSI();
  if (rssi > -50) return 3;
  if (rssi > -60) return 2;
  if (rssi > -70) return 1;
  if (rssi > -80) return 0;
  return -1;
}

