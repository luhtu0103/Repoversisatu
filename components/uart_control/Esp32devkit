static const uint8_t HISTORY_MAX_ENTRIES = 24;
struct HistoryEntry { uint32_t timestamp; char role; char text[420]; };
HistoryEntry historyEntries[HISTORY_MAX_ENTRIES];
Preferences historyPrefs;
uint8_t historyCount = 0, historyNext = 0;
bool historyPrefsReady = false;
void historyLoad() {
  historyPrefsReady = historyPrefs.begin("robotHist", false);
  if (!historyPrefsReady) return;
  historyCount = (uint8_t)min((uint32_t)HISTORY_MAX_ENTRIES, historyPrefs.getUInt("count", 0));
  historyNext = (uint8_t)(historyPrefs.getUInt("next", 0) % HISTORY_MAX_ENTRIES);
  for (uint8_t i = 0; i < HISTORY_MAX_ENTRIES; ++i) {
    char key[5]; snprintf(key, sizeof(key), "h%02u", i);
    if (historyPrefs.getBytesLength(key) == sizeof(HistoryEntry)) historyPrefs.getBytes(key, &historyEntries[i], sizeof(HistoryEntry));
    else memset(&historyEntries[i], 0, sizeof(HistoryEntry));
  }
}
void historyAppend(char role, const char* message) {
  if (!historyPrefsReady || !message || !message[0]) return;
  HistoryEntry entry = {};
  entry.timestamp = (uint32_t)time(nullptr); entry.role = role;
  strlcpy(entry.text, message, sizeof(entry.text));
  historyEntries[historyNext] = entry;
  char key[5]; snprintf(key, sizeof(key), "h%02u", historyNext);
  historyPrefs.putBytes(key, &entry, sizeof(entry));
  historyNext = (uint8_t)((historyNext + 1) % HISTORY_MAX_ENTRIES);
  if (historyCount < HISTORY_MAX_ENTRIES) ++historyCount;
  historyPrefs.putUInt("next", historyNext); historyPrefs.putUInt("count", historyCount);
}
String historyEscapeHtml(const char* value) {
  String out; if (!value) return out;
  for (const char* p = value; *p; ++p) {
    if (*p == '&') out += "&amp;";
    else if (*p == '<') out += "&lt;";
    else if (*p == '>') out += "&gt;";
    else if (*p == '"') out += "&quot;";
    else if ((unsigned char)*p == 39) out += "&#39;";
    else out += *p;
  }
  return out;
}
String historyFormatTime(uint32_t stamp) {
  if (stamp < 1700000000UL) return String("Waktu belum tersedia");
  time_t raw = (time_t)stamp; struct tm info; localtime_r(&raw, &info);
  char buf[24]; strftime(buf, sizeof(buf), "%d/%m/%Y %H:%M", &info); return String(buf);
}

