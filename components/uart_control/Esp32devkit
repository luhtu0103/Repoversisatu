// =====================================================
// PASANG PROGRAM LEWAT BROWSER (OTA)  ->  alamat DevKit + /ota
// File yang diunggah: devkit-ota.bin (dari GitHub Release "devkit-..."), BUKAN yang "pertama-kali".
// Program lama tetap aman kalau unggahan gagal. Butuh skema partisi yang punya dua slot OTA
// (Arduino IDE: "Default 4MB with spiffs").
// =====================================================
// Sandi unggah. KOSONG ("") = tanpa sandi: siapa pun yang ada di Wi-Fi rumah bisa memasang program lewat /ota.
// Mau pakai sandi: isi di antara tanda kutip, misalnya "rahasia123".
static const char* OTA_PASSWORD = "";
static bool otaOk = false;
static String otaErr = "";

static bool otaSandiBenar() {
  if (OTA_PASSWORD[0] == '\0') return true;   // tanpa sandi
  return server.hasArg("pw") && server.arg("pw") == String(OTA_PASSWORD);
}

void handleOtaPage() {
  String h = "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<style>body{margin:0;padding:16px;background:#111318;color:#e7e9ef;font:16px Arial,sans-serif}.wrap{max-width:560px;margin:auto}"
    ".box{background:#20232b;border:1px solid #343844;border-radius:12px;padding:14px;margin:10px 0}"
    "input,button{width:100%;box-sizing:border-box;padding:12px;margin:6px 0;border-radius:9px;border:1px solid #343844;background:#181b22;color:#fff;font-size:16px}"
    "button{background:#2563eb;border:0;font-weight:bold}.back{display:block;color:#fff;background:#343844;padding:12px;border-radius:9px;text-decoration:none;margin:10px 0}"
    ".small{font-size:12px;color:#9ca3af}.bad{color:#f87171}progress{width:100%;height:18px}</style></head><body><div class='wrap'>"
    "<a class='back' href='/'>← Kembali</a><h2>Pasang Program DevKit</h2>";
  h += String("<div class='box small'>Program yang sedang jalan dibuat: ") + __DATE__ + " " + __TIME__ + "</div>";
  {
    h += "<div class='box'><form id='f'>";
    if (OTA_PASSWORD[0] != '\0') h += "<input type='password' id='pw' placeholder='Sandi' autocomplete='off'>";
    h += "<input type='hidden' id='pwx' value=''>"
         "<input type='file' id='bin' accept='.bin'><button type='submit'>Unggah dan pasang</button>"
         "<progress id='p' value='0' max='100' style='display:none'></progress><div id='msg' class='small'></div></form>"
         "<div class='small'>Pakai file <b>devkit-ota.bin</b>. Jangan pakai file &quot;pertama-kali&quot;. Jangan bicara ke robot selama unggah (sekitar 1 menit).</div></div>"
         "<script>document.getElementById('f').onsubmit=function(e){e.preventDefault();"
         "var f=document.getElementById('bin').files[0],pe=document.getElementById('pw'),pw=pe?pe.value:'',m=document.getElementById('msg'),p=document.getElementById('p');"
         "if(!f||(pe&&!pw)){m.textContent='Pilih file (dan isi sandi) dulu.';return;}"
         "var x=new XMLHttpRequest();x.open('POST','/ota_upload?pw='+encodeURIComponent(pw));p.style.display='block';"
         "x.upload.onprogress=function(ev){if(ev.lengthComputable)p.value=ev.loaded*100/ev.total;};"
         "x.onload=function(){m.textContent=x.responseText;if(x.status==200)setTimeout(function(){location='/'},12000);};"
         "x.onerror=function(){m.textContent='Koneksi terputus. Cek apakah DevKit sudah restart.';};"
         "var d=new FormData();d.append('firmware',f);x.send(d);m.textContent='Mengunggah...';};</script>";
  }
  h += "</div></body></html>";
  server.send(200, "text/html; charset=utf-8", h);
}

void handleOtaUpload() {
  HTTPUpload& up = server.upload();
  if (up.status == UPLOAD_FILE_START) {
    otaOk = otaSandiBenar();
    otaErr = otaOk ? "" : "Sandi salah atau OTA belum diaktifkan.";
    if (otaOk) {
      statusSistem = "OTA: menerima program";
      if (!Update.begin(UPDATE_SIZE_UNKNOWN)) { otaOk = false; otaErr = String("Tidak bisa mulai: ") + Update.errorString(); }
    }
  } else if (up.status == UPLOAD_FILE_WRITE) {
    if (otaOk && Update.write(up.buf, up.currentSize) != up.currentSize) {
      otaOk = false; otaErr = String("Gagal menulis: ") + Update.errorString(); Update.abort();
    }
  } else if (up.status == UPLOAD_FILE_END) {
    if (otaOk && !Update.end(true)) { otaOk = false; otaErr = String("Program tidak valid: ") + Update.errorString(); }
  } else if (up.status == UPLOAD_FILE_ABORTED) {
    if (otaOk) Update.abort();
    otaOk = false; otaErr = "Unggahan dibatalkan.";
  }
}

void handleOtaDone() {
  if (otaOk) {
    server.send(200, "text/plain; charset=utf-8", "Berhasil. DevKit restart sendiri, tunggu sekitar 10 detik.");
    delay(600);
    ESP.restart();
  } else {
    server.send(400, "text/plain; charset=utf-8", otaErr.length() ? otaErr : String("Gagal. Program lama tetap dipakai."));
  }
}

// Halaman riwayat lengkap dari file (150 pesan terakhir, paling lama di atas) + tombol hapus.
void handleHistoryAll() {
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/html; charset=utf-8", "");
  server.sendContent("<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<style>body{margin:0;padding:16px;background:#111318;color:#e7e9ef;font:16px Arial,sans-serif}.wrap{max-width:760px;margin:auto}"
    ".item{background:#20232b;border:1px solid #343844;border-radius:12px;padding:14px;margin:10px 0;white-space:pre-wrap;overflow-wrap:anywhere}"
    ".u{border-left:4px solid #60a5fa}.a{border-left:4px solid #34d399}.meta{font-size:12px;color:#9ca3af;margin-bottom:8px}"
    ".back{display:block;color:#fff;background:#343844;padding:12px;border-radius:9px;text-decoration:none;margin:10px 0}"
    ".del{background:#7f1d1d}</style></head><body><div class='wrap'>"
    "<a class='back' href='/history'>← Riwayat per sesi</a><h2>Riwayat Lengkap (file)</h2>");
  if (!historyFsReady) {
    server.sendContent("<div class='item'>Penyimpanan file tidak tersedia di DevKit ini (skema partisi tanpa SPIFFS/LittleFS). Hanya riwayat 24 pesan yang aktif.</div>");
  } else {
    char buf[HIST_TEXT_MAX + 40];
    int totalLines = 0;
    File f = LittleFS.open(HIST_FILE, "r");
    if (f) {
      while (f.available()) { size_t g = f.readBytesUntil('\n', buf, sizeof(buf) - 1); if (g > 0) ++totalLines; }
      f.seek(0);
      const int skip = totalLines > 150 ? totalLines - 150 : 0;
      server.sendContent("<p>" + String(totalLines) + " pesan tersimpan di file. Menampilkan " + String(totalLines - skip) + " terakhir.</p>");
      int idx = 0;
      while (f.available()) {
        size_t g = f.readBytesUntil('\n', buf, sizeof(buf) - 1);
        buf[g] = '\0';
        if (g == 0) continue;
        if (idx++ < skip) continue;
        uint32_t ts = 0; char role = 'U'; const char* text = nullptr;
        if (!historyParseLine(buf, &ts, &role, &text)) continue;
        String item = String("<div class='item ") + (role == 'U' ? "u" : "a") + "'><div class='meta'>" +
                      (role == 'U' ? "PENGGUNA" : "GEMINI") + " · " + historyFormatTime(ts) + "</div>" +
                      historyEscapeHtml(text) + "</div>";
        server.sendContent(item);
      }
      f.close();
    } else {
      server.sendContent("<div class='item'>Belum ada riwayat di file.</div>");
    }
  }
  server.sendContent("<a class='back del' href='/history_clear' onclick=\"return confirm('Hapus SEMUA riwayat percakapan?')\">Hapus semua riwayat</a>"
                     "</div></body></html>");
  server.sendContent("");
}

