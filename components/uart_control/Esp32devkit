static const char* ROBOT_EVT_FILE = "/robot_evt.log";
static const char* ROBOT_EVT_TMP = "/robot_evt.tmp";
static const size_t ROBOT_EVT_MAX = 16 * 1024;
static const int ROBOT_SAMPLE_MAX = 60;

struct RobotSample { uint32_t ts; int8_t rssi; uint16_t ramKb; };
static RobotSample robotSamples[ROBOT_SAMPLE_MAX];
static int robotSampleCount = 0, robotSampleNext = 0;
static char robotVer[24] = "";
static uint32_t robotUptime = 0, robotRam = 0, robotRamMin = 0, robotPsram = 0, robotDrops = 0;
static int robotRssi = 0, robotChan = 0, robotWs = 0;
static long robotMicPeak = -1, robotMicClip = -1;   // -1 = robot belum melaporkan
static uint32_t robotLastMs = 0;     // millis() saat laporan terakhir masuk
static bool robotEverReported = false;

static int robotSplit(char* s, char** f, int maxf) {
  int n = 0; f[n++] = s;
  for (char* p = s; *p && n < maxf; ++p) { if (*p == '|') { *p = '\0'; f[n++] = p + 1; } }
  return n;
}

static void robotEvtTrim() {
  File src = LittleFS.open(ROBOT_EVT_FILE, "r");
  if (!src) return;
  size_t size = src.size();
  if (size <= ROBOT_EVT_MAX) { src.close(); return; }
  src.seek(size / 2);
  while (src.available()) { int c = src.read(); if (c < 0 || c == '\n') break; }
  File dst = LittleFS.open(ROBOT_EVT_TMP, "w");
  if (!dst) { src.close(); return; }
  uint8_t buf[256];
  while (src.available()) { size_t n = src.read(buf, sizeof(buf)); if (n == 0) break; dst.write(buf, n); }
  src.close(); dst.close();
  LittleFS.remove(ROBOT_EVT_FILE);
  LittleFS.rename(ROBOT_EVT_TMP, ROBOT_EVT_FILE);
}

static void robotEvtAppend(const char* kind, int rssi, uint32_t ram, int ws, const char* detail) {
  if (!historyFsReady) return;
  char line[160];
  int n = snprintf(line, sizeof(line), "%lu|%s|%d|%lu|%d|%s\n", (unsigned long)time(nullptr), kind, rssi, (unsigned long)ram, ws, detail ? detail : "");
  if (n <= 0 || n >= (int)sizeof(line)) return;
  File f = LittleFS.open(ROBOT_EVT_FILE, "a");
  if (!f) return;
  f.write((const uint8_t*)line, (size_t)n);
  size_t size = f.size();
  f.close();
  if (size > ROBOT_EVT_MAX) robotEvtTrim();
}

// Dipanggil dari eksekusiTeksPerintah. Mengembalikan true jika baris itu laporan robot.
bool robotTerimaLaporan(const String& cmd) {
  bool isStat = cmd.startsWith("STAT|");
  bool isEvt = cmd.startsWith("EVT|");
  if (!isStat && !isEvt) return false;
  char buf[200];
  size_t len = cmd.length(); if (len >= sizeof(buf)) return true;   // terlalu panjang: abaikan
  memcpy(buf, cmd.c_str(), len + 1);
  char* f[12]; int n = robotSplit(buf, f, 12);
  if (isStat && n >= 10) {
    strncpy(robotVer, f[1], sizeof(robotVer) - 1); robotVer[sizeof(robotVer) - 1] = '\0';
    robotUptime = strtoul(f[2], nullptr, 10); robotRssi = atoi(f[3]); robotChan = atoi(f[4]);
    robotRam = strtoul(f[5], nullptr, 10); robotRamMin = strtoul(f[6], nullptr, 10); robotPsram = strtoul(f[7], nullptr, 10);
    robotWs = atoi(f[8]); robotDrops = strtoul(f[9], nullptr, 10);
    robotMicPeak = (n >= 12) ? atol(f[10]) : -1; robotMicClip = (n >= 12) ? atol(f[11]) : -1;
    robotLastMs = millis(); robotEverReported = true;
    robotSamples[robotSampleNext].ts = (uint32_t)time(nullptr);
    robotSamples[robotSampleNext].rssi = (int8_t)constrain(robotRssi, -127, 0);
    robotSamples[robotSampleNext].ramKb = (uint16_t)min((uint32_t)65535, robotRam / 1024);
    robotSampleNext = (robotSampleNext + 1) % ROBOT_SAMPLE_MAX;
    if (robotSampleCount < ROBOT_SAMPLE_MAX) ++robotSampleCount;
  } else if (isEvt && n >= 5) {
    robotEvtAppend(f[1], atoi(f[2]), strtoul(f[3], nullptr, 10), atoi(f[4]), n >= 6 ? f[5] : "");
  }
  return true;
}

